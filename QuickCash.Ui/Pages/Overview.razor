@page "/overview"
@using QuickCash.Ui.Api.Models
@using QuickCash.Ui.Api.Services
@inject OverviewApi Api

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="m-0">Monthly Overview</h2>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label">Year</label>
                <input class="form-control" type="number" @bind="Year" min="2000" max="2100" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label">Month</label>
                <input class="form-control" type="number" @bind="Month" min="1" max="12" />
            </div>

            <div class="col-12 col-md-2">
                <button class="btn btn-outline-primary w-100" @onclick="Load">Load</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

@if (IsLoading)
{
    <div class="text-muted">Loading…</div>
}
else if (OverviewModel == null)
{
    <div class="text-muted">Select a year/month and click Load.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title mb-3">Totals</h5>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="text-success">Income</div>
                    <div class="fs-4 fw-semibold">@OverviewModel.TotalIncome.ToString("C")</div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="text-danger">Expenses</div>
                    <div class="fs-4 fw-semibold">@OverviewModel.TotalExpenses.ToString("C")</div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="text-muted">Net</div>
                    <div class="fs-4 fw-semibold @(OverviewModel.Net >= 0 ? "text-success" : "text-danger")">
                        @OverviewModel.Net.ToString("C")
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (OverviewModel.Transactions.Count == 0)
    {
        <div class="text-muted">No transactions for this month.</div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th class="text-end">Amount</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in OverviewModel.Transactions)
                        {
                            <tr>
                                <td>@t.Date.ToString("yyyy-MM-dd")</td>

                                <td>
                                    <span class="fw-semibold">@t.CategoryName</span>
                                    <span class="ms-2 badge @(t.CategoryType == 1 ? "bg-success" : "bg-danger")">
                                        @(t.CategoryType == 1 ? "Income" : "Expense")
                                    </span>
                                </td>

                                <td class="text-end @(t.CategoryType == 1 ? "text-success" : "text-danger")">
                                    @t.Amount.ToString("C")
                                </td>

                                <td class="text-muted">@t.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private int Year { get; set; } = DateTime.Now.Year;
    private int Month { get; set; } = DateTime.Now.Month;

    private bool IsLoading { get; set; }
    private string? Error { get; set; }

    private OverviewDto? OverviewModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        Error = null;
        IsLoading = true;

        try
        {
            OverviewModel = await Api.GetAsync(Year, Month);
        }
        catch (Exception ex)
        {
            OverviewModel = null;
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
