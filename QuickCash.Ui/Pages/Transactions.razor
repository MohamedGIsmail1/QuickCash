@page "/transactions"
@using QuickCash.Ui.Api.Models
@using QuickCash.Ui.Api.Services
@inject TransactionsApi Api
@inject CategoriesApi CategoriesApi

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="m-0">Transactions</h2>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label">Year</label>
                <input class="form-control" type="number" @bind="Year" min="2000" max="2100" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label">Month</label>
                <input class="form-control" type="number" @bind="Month" min="1" max="12" />
            </div>

            <div class="col-12 col-md-2">
                <button class="btn btn-outline-primary w-100" @onclick="Load">Load</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

@if (IsLoading)
{
    <div class="text-muted">Loading…</div>
}
else if (Items.Count == 0)
{
    <div class="text-muted">No transactions for this month.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                        <th>Note</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Items)
                    {
                        <tr>
                            <td>@t.Date.ToString("yyyy-MM-dd")</td>

                            <td>
                                <span class="fw-semibold">@t.CategoryName</span>
                                <span class="ms-2 badge @(t.CategoryType == 1 ? "bg-success" : "bg-danger")">
                                    @(t.CategoryType == 1 ? "Income" : "Expense")
                                </span>
                            </td>

                            <td class="text-end @(t.CategoryType == 1 ? "text-success" : "text-danger")">
                                @t.Amount.ToString("C")
                            </td>

                            <td class="text-muted">@t.Note</td>

                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(t.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Add transaction</h5>

        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label">Date</label>
                <input class="form-control" type="date" @bind="NewDate" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">Amount</label>
                <input class="form-control" type="number" step="0.01" @bind="NewAmount" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">Category</label>
                <select class="form-select" @bind="SelectedCategoryId">
                    <option value="">-- select --</option>
                    @foreach (var c in Categories.OrderBy(c => c.Type).ThenBy(c => c.Name))
                    {
                        <option value="@c.Id">@c.Name (@(c.Type == 1 ? "Income" : "Expense"))</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">Note</label>
                <input class="form-control" @bind="NewNote" />
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="Create">Create</button>
        </div>
    </div>
</div>

@code {

    private List<CategoryDto> Categories { get; set; } = new();
    private int? SelectedCategoryId { get; set; }

    private int Year { get; set; } = DateTime.Now.Year;
    private int Month { get; set; } = DateTime.Now.Month;

    private bool IsLoading { get; set; }
    private string? Error { get; set; }

    private List<TransactionDto> Items { get; set; } = new();

    // “Add transaction” form
    private DateTime NewDate { get; set; } = DateTime.Today;
    private decimal NewAmount { get; set; }
    private string? NewNote { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Categories = await CategoriesApi.GetAllAsync();
        await Load();
    }

    private async Task Load()
    {
        Error = null;
        IsLoading = true;

        try
        {
            Items = await Api.GetByMonthAsync(Year, Month);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Items = new();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Create()
    {
        Error = null;

        if (SelectedCategoryId is null)
        {
            Error = "Please select a category.";
            return;
        }

        try
        {
            var req = new CreateTransactionRequest
            {
                Date = NewDate,
                Amount = NewAmount,
                CategoryId = SelectedCategoryId.Value,
                Note = NewNote
            };

            await Api.CreateAsync(req);

            NewAmount = 0;
            NewNote = null;
            SelectedCategoryId = null;

            await Load();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private async Task Delete(int id)
    {
        Error = null;

        try
        {
            await Api.DeleteAsync(id);
            await Load();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }
}
